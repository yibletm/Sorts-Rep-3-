    public static int[] MergeRec(int[] left, int[] right)
    {
        int arrlen = left.length + right.length;
        int[] arr = new arr[arrlen];
        boolean arrops = true;
        int i = 0;
        int add = 0;
        while(arrops)
        {
            if(i >= left.length)
            {
                add = right[i-left.length];
                addsort(add, arr, i);
            }
            else
            {
                add = left[i];
                addsort(add, arr, i);
            }


            if(i == arrlen)
            {
                arrops = false;
            }
            i++;
        }

    }
    
    public static void addsort(int add; int[] arr, int i)
    {
        if(i == arr.length)
        {
            return;
        }
        else
        {
            for(int j=0; j<i; j++)
            {
                if(add < arr[j])
                {
                    arr[j+1] = arr[j];
                    arr[j] = add;
                    return;
                }
                if(j == i-1)
                {
                    arr[j+1] = add;
                }
            }
        }
    }

